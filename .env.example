# 链网E判 9.5.6 - 版式微调与占位值保护版
# 只需填写下列两个密钥。请勿把密钥写入前端文件。
# 监听地址：8000 被占用时 start_web.py 会自动顺延到空闲端口，也可在此固定。
APP_HOST=127.0.0.1
APP_PORT=8000

TAVILY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_BACKUP=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
DEEPSEEK_STRUCTURED_FALLBACK_TO_PRO=true
ENABLE_PRO_DECISION_ANALYSIS=true
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_IDENTITY_CONTEXT_CHARS=7000
DEEPSEEK_PROFILE_CONTEXT_CHARS=22000
DEEPSEEK_RELATION_CONTEXT_CHARS=30000
DEEPSEEK_RISK_CONTEXT_CHARS=30000
DEEPSEEK_PROFILE_MAX_TOKENS=3000
DEEPSEEK_RELATION_MAX_TOKENS=4500
DEEPSEEK_RISK_MAX_TOKENS=4500
DEEPSEEK_DECISION_MAX_TOKENS=2600

TAVILY_BASE_URL=https://api.tavily.com
TAVILY_TIMEOUT_SECONDS=15
TAVILY_IDENTITY_DEPTH=basic
TAVILY_DETAIL_DEPTH=basic
TAVILY_RETRY_DEPTH=advanced
TAVILY_COUNTRY=
TAVILY_MAX_RESULTS_IDENTITY=7
TAVILY_MAX_RESULTS_DETAIL=8
TAVILY_MAX_SOURCES=40
TAVILY_MIN_SCORE=0.35
MINIMUM_SOURCE_RELEVANCE=3
TAVILY_EXTRACT_ENABLED=true
TAVILY_EXTRACT_DEPTH=basic
TAVILY_EXTRACT_MAX_URLS=15
TAVILY_EXTRACT_CHUNKS_PER_SOURCE=3
TAVILY_EXTRACT_TIMEOUT_SECONDS=18
ADAPTIVE_FOLLOWUP_ENABLED=true
TAVILY_FOLLOWUP_ROUNDS=3

STOCK_RESOLVER_ENABLED=true
STOCK_RESOLVER_TIMEOUT_SECONDS=7
LISTED_PROFILE_RESOLVER_ENABLED=true
CACHE_TTL_HOURS=168
TASK_WORKERS=6
LOG_LEVEL=INFO
